# ==========================================================
# FIRSTSAVVY ENVIRONMENT CONFIGURATION TEMPLATE
# Local development and QA runs seamlessly in sandbox mode 
# without requiring live production credentials.
# ==========================================================

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000

# Supabase / PostgreSQL Credentials (Optional for local demo mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Plaid Sandbox Credentials (Optional - built-in sandbox active by default)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# Transactional Email (Optional)
RESEND_API_KEY=re_your_api_key

# Error Monitoring (Optional)
NEXT_PUBLIC_SENTRY_DSN=
